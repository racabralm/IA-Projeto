import pandas as pd
from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, precision_score
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Carregar e preparar os dados
df = pd.read_csv('../data/dataset_acoes_negocios.csv')
df['Date'] = pd.to_datetime(df['Date'])

# 2. Engenharia de Recursos
df['Next_Close'] = df.groupby('Ticker')['Close'].shift(-1)
df['Target'] = (df['Next_Close'] > df['Close']).astype(int)
df = df.dropna(subset=['Next_Close']).copy()

df['Daily_Return'] = (df['Close'] - df['Open']) / df['Open']
df['Volatility'] = (df['High'] - df['Low']) / df['Low']
df['Volume_Scaled'] = df['Volume'] / 1e6

features = ['Open', 'High', 'Low', 'Close', 'Daily_Return', 'Volatility', 'Volume_Scaled']

# 3. Modelagem
resultados = []
for ticker in df['Ticker'].unique():
    df_ticker = df[df['Ticker'] == ticker].copy()
    
    X = df_ticker[features]
    y = df_ticker['Target']
    
    # 80% treino, 20% teste (sem embaralhar por ser série temporal)
    split_index = int(len(df_ticker) * 0.8)
    X_train, X_test = X.iloc[:split_index], X.iloc[split_index:]
    y_train, y_test = y.iloc[:split_index], y.iloc[split_index:]
    
    # Regressão Logística
    lr = LogisticRegression(max_iter=1000, random_state=42)
    lr.fit(X_train, y_train)
    lr_acc = accuracy_score(y_test, lr.predict(X_test))
    
    # Random Forest
    rf = RandomForestClassifier(n_estimators=100, random_state=42)
    rf.fit(X_train, y_train)
    rf_pred = rf.predict(X_test)
    
    resultados.append({
        'Ativo': ticker,
        'Regressão Logística (Acc)': lr_acc,
        'Random Forest (Acc)': accuracy_score(y_test, rf_pred),
        'Random Forest (Precision)': precision_score(y_test, rf_pred, zero_division=0)
    })

df_resultados = pd.DataFrame(resultados)
display(df_resultados)
